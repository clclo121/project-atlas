{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuliuyun/project-atlas/schema/external-evidence.schema.json",
  "title": "project-atlas external evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "external_evidence"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "external_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "source_type", "path"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "generated_at": {
            "type": "string"
          },
          "base_commit": {
            "type": "string"
          },
          "tool_version": {
            "type": "string"
          },
          "coverage_summary": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "external_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_type", "path"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "generated_at": {
          "type": "string"
        },
        "base_commit": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "coverage_summary": {
          "type": "string"
        }
      }
    }
  }
}
