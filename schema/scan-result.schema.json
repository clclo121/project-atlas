{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuliuyun/project-atlas/schema/scan-result.schema.json",
  "title": "project-atlas scan result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "review_depth",
    "repo",
    "base_commit",
    "worktree_diff_hash",
    "changed_files",
    "project",
    "entries",
    "knowledge",
    "facts",
    "candidates",
    "evidence_plan",
    "review_plan",
    "sensitive_config_findings",
    "external_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": ["full", "changed"]
    },
    "review_depth": {
      "enum": ["standard", "deep"]
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string"
    },
    "worktree_diff_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maven", "modules"],
      "properties": {
        "name": {
          "type": "string"
        },
        "maven": {
          "type": "object"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pom_info"
          }
        }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/entry"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_manifest", "files", "empty_sections"],
      "properties": {
        "has_manifest": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "empty_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "workflows", "integrations", "risks"],
      "properties": {
        "domains": {
          "$ref": "#/$defs/candidate_list"
        },
        "workflows": {
          "$ref": "#/$defs/candidate_list"
        },
        "integrations": {
          "$ref": "#/$defs/candidate_list"
        },
        "risks": {
          "$ref": "#/$defs/candidate_list"
        },
        "contracts": {
          "$ref": "#/$defs/candidate_list"
        },
        "quality": {
          "$ref": "#/$defs/candidate_list"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp_tools", "adapter_assets", "schemas", "tests"],
      "properties": {
        "package_json": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "bin", "scripts", "files", "exports"],
          "properties": {
            "path": { "type": "string" },
            "name": { "type": "string" },
            "bin": { "type": "array", "items": { "type": "string" } },
            "scripts": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "array", "items": { "type": "string" } },
            "exports": { "type": "array", "items": { "type": "string" } }
          }
        },
        "mcp_tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact_item" }
        },
        "adapter_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact_item" }
        },
        "schemas": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact_item" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact_item" }
        }
      }
    },
    "evidence_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_plan_item"
      }
    },
    "review_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_plan_item"
      }
    },
    "sensitive_config_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sensitive_finding"
      }
    },
    "external_evidence": {
      "type": "array",
      "items": {
        "$ref": "external-evidence.schema.json#/$defs/external_evidence_item"
      }
    },
    "external_evidence_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check_item"
      }
    }
  },
  "$defs": {
    "fact_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "name"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "path": { "type": "string" },
        "name": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "evidence_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "candidate_category", "recommended_files", "required_evidence_types", "reason", "missing_evidence", "confidence"],
      "properties": {
        "target": { "type": "string", "pattern": "^knowledge/" },
        "candidate_category": { "type": "string" },
        "recommended_files": { "type": "array", "items": { "type": "string" } },
        "required_evidence_types": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "missing_evidence": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "review_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "review_depth", "focus", "required_external_evidence", "risk_flags", "related_facts", "recommended_files", "confidence"],
      "properties": {
        "target": { "type": "string", "pattern": "^knowledge/" },
        "review_depth": { "const": "deep" },
        "focus": { "type": "array", "items": { "type": "string" } },
        "required_external_evidence": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "related_facts": { "type": "array", "items": { "type": "string" } },
        "recommended_files": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "check_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rule_id", "path", "message", "suggestion"],
      "properties": {
        "level": { "enum": ["error", "warning"] },
        "rule_id": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "suggestion": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "pom_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "groupId", "artifactId", "version", "modules"],
      "properties": {
        "path": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidate_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reason"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^knowledge/"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category": {
          "type": "string"
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sensitive_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rule_id", "rule_category", "action"],
      "properties": {
        "path": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_category": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    }
  }
}
