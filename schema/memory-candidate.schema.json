{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuliuyun/project-atlas/schema/memory-candidate.schema.json",
  "title": "project-atlas memory candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_files", "memories"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!(?:\\.git|\\.project-atlas|\\.code-review-graph)(?:[\\\\/]|$))(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))(?!.*[\\r\\n]).+"
      }
    },
    "memories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "memory_type", "topic", "scope", "confidence", "summary", "body"],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^knowledge/(?!\\.\\.(?:/|$))(?!.*(?:/)\\.\\.(?:/|$))(?!.*[\\r\\n]).+"
          },
          "memory_type": {
            "enum": ["decision", "experience", "project_fact"]
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\r\\n]).+$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\r\\n]).+$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\\r\\n]).+$"
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "pattern": "^(?!.*[\\r\\n]).*$"
          },
          "related_docs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!(?:\\.git|\\.project-atlas|\\.code-review-graph)(?:[\\\\/]|$))(?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))(?!.*[\\r\\n]).+"
            }
          }
        }
      }
    }
  }
}
